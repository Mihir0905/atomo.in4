<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50" data-home="<%= path === '/' ? 'true' : 'false' %>">
  <div class="site-header__inner">
    <nav class="site-header__nav hidden lg:flex items-center" aria-label="Main navigation">
      <a href="/" class="site-header__logo-link" aria-label="Atomo home">
        <img src="/assets/brand/atomo-logo.png" alt="" width="108" height="28" class="site-header__logo-img brightness-0 invert" />
        <span class="sr-only">Atomo</span>
      </a>

      <% primaryNav.forEach(function(item, navIndex) { %>
      <div
        class="site-header__trigger"
        data-nav-trigger
        data-nav-index="<%= navIndex %>"
        <% if (item.children) { %>data-has-dropdown="true"<% } %>
      >
        <div class="site-header__trigger-row flex items-center">
          <a
            href="<%= item.href %>"
            class="nav-link"
            <% if (item.children) { %>
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="nav-mega-panel-<%= navIndex %>"
            <% } %>
          ><%= item.label %></a>
          <% if (item.children) { %>
          <span class="nav-chevron flex h-5 w-4 items-center justify-center shrink-0" aria-hidden="true">
            <svg class="h-3 w-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </span>
          <% } %>
        </div>
      </div>
      <% }); %>
    </nav>

    <a href="/" class="site-header__logo-link site-header__logo-link--mobile lg:hidden" aria-label="Atomo home">
      <img src="/assets/brand/atomo-logo.png" alt="" width="108" height="28" class="site-header__logo-img brightness-0 invert" />
    </a>

    <button type="button" id="mobile-menu-toggle" class="site-header__toggle lg:hidden z-50 flex items-center justify-center p-0" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg class="menu-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h16M4 15h16"/></svg>
      <svg class="close-icon hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Desktop mega menu -->
  <div class="nav-mega hidden lg:block" data-nav-mega aria-hidden="true">
    <div class="nav-mega__bridge" aria-hidden="true"></div>
    <div class="nav-mega__surface">
      <div class="nav-mega__inner">
        <% primaryNav.forEach(function(item, navIndex) { %>
        <% if (item.children) { %>
        <div
          class="nav-mega__panel"
          id="nav-mega-panel-<%= navIndex %>"
          data-nav-panel="<%= navIndex %>"
          role="menu"
          aria-label="<%= item.label %> menu"
          hidden
        >
          <div
            class="nav-mega__grid"
            style="--nav-mega-columns: <%= item.children.length %>"
          >
            <% item.children.forEach(function(child, childIndex) { %>
            <a
              href="<%= child.href %>"
              class="nav-mega__link"
              role="menuitem"
              style="--nav-stagger: <%= childIndex %>"
            >
              <span class="nav-mega__link-label"><%= child.label %></span>
              <% if (child.description) { %>
              <span class="nav-mega__link-desc"><%= child.description %></span>
              <% } %>
            </a>
            <% }); %>
          </div>
        </div>
        <% } %>
        <% }); %>
      </div>
    </div>
  </div>
</header>

<div id="mobile-nav" class="mobile-nav fixed inset-0 z-40 flex flex-col lg:hidden" role="dialog" aria-modal="true" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-nav__content container-site flex flex-1 flex-col overflow-y-auto pt-20 pb-8">
    <nav class="mobile-nav__list space-y-2">
      <% primaryNav.forEach(function(item, navIndex) { %>
      <div class="mobile-nav__item" data-mobile-nav-item style="--nav-stagger: <%= navIndex %>">
        <button
          type="button"
          class="mobile-nav__trigger"
          data-mobile-nav-trigger
          aria-expanded="false"
          aria-controls="mobile-nav-panel-<%= navIndex %>"
        >
          <span class="mobile-nav__trigger-label"><%= item.label %></span>
          <span class="mobile-nav__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </button>
        <div
          class="mobile-nav__panel"
          id="mobile-nav-panel-<%= navIndex %>"
          data-mobile-nav-panel
          hidden
        >
          <div class="mobile-nav__panel-inner">
            <a href="<%= item.href %>" class="mobile-nav__link mobile-nav__link--overview" style="--nav-stagger: 0">Overview</a>
            <% if (item.children) { item.children.forEach(function(child, childIndex) { %>
            <a href="<%= child.href %>" class="mobile-nav__link" style="--nav-stagger: <%= childIndex + 1 %>"><%= child.label %></a>
            <% }); } %>
          </div>
        </div>
      </div>
      <% }); %>
    </nav>
    <div class="mobile-nav__footer mt-8 pb-4" style="--nav-stagger: <%= primaryNav.length %>">
      <a href="/contact" class="btn-primary mobile-nav__cta w-full justify-center flex">Talk to Atomo</a>
    </div>
  </div>
</div>
